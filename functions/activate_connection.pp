# Activates (or deactivates, or removes) the connection after configuration
#
# Uses $networkmanager::activation_tag (the tag of the virtual execs, collected by networkmanager::reload) and
# $networkmanager::connections_dir (the directory with the keyfiles).
#
# @param uuid
#   uuid of the connection as generated by networkmanager::connection_uuid function or supplied by user
# @param id
#   name of the connection (here used for a file name)
# @param state
#   the connection state
# @param ensure
#   'absent' deactivates the connection before its keyfile is removed and makes NetworkManager forget it afterwards (on every run while NetworkManager still knows it, a removal which was interrupted is finished by the next run)
# @param after
#   uuids of the connections (master, parent) which are activated before this one when they are managed by this module
function networkmanager::activate_connection (
  Pattern[/\A\h{8}-(\h{4}-){3}\h{12}\z/]        $uuid,
  String[3]                                     $id,
  Enum['up', 'down']                            $state,
  Enum['absent', 'present']                     $ensure = 'present',
  Array[Pattern[/\A\h{8}-(\h{4}-){3}\h{12}\z/]] $after = [],
) {
  $keyfile = Networkmanager_keyfile["${networkmanager::connections_dir}/${id}.nmconnection"]
  $is_active = "/usr/bin/nmcli -t -f GENERAL con show ${uuid} | /usr/bin/grep 'GENERAL.STATE:activated'"

  if 'absent' == $ensure {
    @exec {
      "deactivate connection ${uuid}":
        command  => networkmanager::reload_connection($uuid, 'down'),
        provider => 'shell',
        group    => 'root',
        user     => 'root',
        onlyif   => $is_active,
        before   => $keyfile,
        tag      => $networkmanager::activation_tag;
      "forget connection ${uuid}":
        command   => '/usr/bin/nmcli connection reload',
        provider  => 'shell',
        group     => 'root',
        user      => 'root',
        onlyif    => "/usr/bin/nmcli -t -f connection.id connection show ${uuid}",
        subscribe => $keyfile,
        tag       => $networkmanager::activation_tag;
    }
  } elsif 'up' == $state {
    @exec {
      "activate connection after initial config ${uuid}":
        command     => networkmanager::reload_connection($uuid, $state),
        provider    => 'shell',
        group       => 'root',
        user        => 'root',
        subscribe   => $keyfile,
        refreshonly => true,
        tag         => $networkmanager::activation_tag;
      "activate connection always ${uuid}":
        command  => networkmanager::reload_connection($uuid, $state),
        provider => 'shell',
        group    => 'root',
        user     => 'root',
        unless   => $is_active,
        require  => Exec["activate connection after initial config ${uuid}"],
        tag      => $networkmanager::activation_tag;
    }
    # the master and the parent connections of this module are activated first
    $after.filter |$other| { $other != $uuid }.each |$other| {
      Exec <| title == "activate connection always ${other}" |> -> Exec["activate connection after initial config ${uuid}"]
    }
  } else {
    # not refreshonly: a change of the state alone (the same keyfile) has to deactivate the connection too
    @exec {
      "deactivate connection ${uuid}":
        command  => networkmanager::reload_connection($uuid, $state),
        provider => 'shell',
        group    => 'root',
        user     => 'root',
        onlyif   => $is_active,
        require  => $keyfile,
        tag      => $networkmanager::activation_tag;
    }
  }
}
